# Direct MLflow HTTP and loopback-only Gitea port defaults. Credentials are generated separately by make init.
MLFLOW_PORT=7871
MLFLOW_GITEA_PORT=7872
MLFLOW_SECRETS_DIR=./infra/mlflow/.secrets
# Optional comma-separated host:port entries for direct access from another device.
# MLFLOW_EXTRA_ALLOWED_HOSTS=mlflow.example.internal:7871
# Use the browser-visible scheme, hostname, and port for additional origins.
# MLFLOW_SERVER_CORS_ALLOWED_ORIGINS=http://mlflow.example.internal:7871
