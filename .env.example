# Copy to .env before starting the stack.
CLEARML_DATA_ROOT=./docker-data
CLEARML_WEB_PORT=7861
CLEARML_API_PORT=7862
CLEARML_FILES_PORT=7863
CLEARML_FILES_HOST=http://localhost:7863
GITEA_IMAGE=docker.gitea.com/gitea:28.1.0
GITEA_PORT=7864
GITEA_PUBLIC_HOST=localhost
GITEA_RUNNER_IMAGE=docker.gitea.com/runner:2.3.0
RUSTFS_IMAGE=rustfs/rustfs@sha256:8cc9801755448b71a786705ce76692c77e14936cccd87cf2fc31842e58f4d1ff
RUSTFS_DATA_ROOT=./docker-data/rustfs
RUSTFS_PUBLIC_HOST=localhost
RUSTFS_API_PORT=7868
RUSTFS_CONSOLE_PORT=7869
RUSTFS_BUCKET=tonops-artifacts
# Generate unique values for both. Keep this file private; these are RustFS admin credentials.
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME
CLEARML_SERVER_BASE=clearml/server:latest
CLEARML_IAM_ENABLED=true
CLEARML_IAM_SELF_SIGNUP_ENABLED=true
CLEARML_IAM_BOOTSTRAP_ADMIN_USERNAME=admin
# This path is inside the API container. Create the file under
# ${CLEARML_DATA_ROOT}/config/iam-admin-password on the host.
CLEARML_IAM_BOOTSTRAP_ADMIN_PASSWORD_FILE=/opt/clearml/config/iam-admin-password

# Project overview AI. Credentials are used only by the API server.
LLM_BASE_URL=http://your-llm-host:8000/v1
LLM_MODEL=glm53-flash
LLM_API_KEY=CHANGE_ME
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=8192
LLM_MAX_TASKS=50
